{
  "description": "1M keys, 60s window, active-defrag ON (both), compressible realistic JSON corpus. Studies the memory<->latency tradeoff with stabilized tails + defrag RSS reclaim.",
  "output_directory": "/tmp/cbench-1m-defrag/results",
  "servers_directory": "/tmp/cbench-1m-defrag/servers",
  "benchmark_binary": "valkey-benchmark",
  "server_binary": "valkey-server",
  "iterations": 3,
  "reference_config": "off",
  "setup_timeout_seconds": 900,

  "data_model": {
    "value_shape": "json",
    "value_size_distribution": "lognormal:512:0.8",
    "value_size_min": 256,
    "value_size_max": 8192,
    "seed": 1234,
    "corpus_entries": 50000,
    "key_count": 1000000,
    "key_distribution": "zipf:0.99"
  },

  "workload": {
    "target_tps": 10000,
    "commands": [
      { "type": "get", "ratio": 0.8 },
      { "type": "set", "ratio": 0.2 }
    ],
    "connections_total": 16,
    "max_clients_per_process": 8,
    "pipeline": 1,
    "measurement_duration_seconds": 60
  },

  "profile_prep": {
    "plateau_metric": "compression_compressed_objects",
    "plateau_tolerance_pct": 5,
    "plateau_window_polls": 3,
    "poll_interval_seconds": 2,
    "max_timeout_seconds": 300
  },

  "configs": [
    {
      "name": "off",
      "compression": { "master_switch": "off" },
      "extra_args": ["--activedefrag", "yes", "--active-defrag-ignore-bytes", "10mb", "--active-defrag-threshold-lower", "5"]
    },
    {
      "name": "compression-on",
      "compression": {
        "master_switch": "compression",
        "automatic_sweeper": "enabled",
        "min_value_size": 256,
        "max_value_size": 8192,
        "min_idle_seconds": 2,
        "threads": 4
      },
      "extra_args": ["--activedefrag", "yes", "--active-defrag-ignore-bytes", "10mb", "--active-defrag-threshold-lower", "5"]
    }
  ]
}
